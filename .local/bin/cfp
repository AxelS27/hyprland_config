#!/usr/bin/env python3

################################
# GENERATE COLORS FROM PALETTE #
################################

import json, sys, pathlib

if len(sys.argv) < 2:
    print("[LIEM]Usage: gen_theme.py <theme_dir>")
    sys.exit(1)

theme_dir = pathlib.Path(sys.argv[1]).expanduser()

palette_file = theme_dir / "palette.json"
if not palette_file.exists():
    print(f"[LIEM]Palette not found: {palette_file}")
    sys.exit(1)


palette = json.loads(palette_file.read_text())

def hex_to_rgb(hex_color):
    hex_color = hex_color.lstrip("#")
    return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))

colors = []
for name, hex_color in palette.items():
    r, g, b = hex_to_rgb(hex_color)
    colors.append({
        "name": name,
        "hex": hex_color,
        "r": r,
        "g": g,
        "b": b
    })

def gen_rasi():
    lines = ["* {"]
    for c in colors:
        lines.append(f"    {c['name']}: {c['hex']};")
    lines.append("}")
    return "\n".join(lines)


def gen_css():
    return "\n".join(f"@define-color {c['name']} {c['hex']};" for c in colors)

def gen_conf():
    lines = [
        f"${c['name']} = rgba({c['r']},{c['g']},{c['b']},1.0)"
        for c in colors
    ]
    lines += [
        "",
        "$success = $green",
        "$error   = $red",
        "$warning = $yellow"
    ]
    return "\n".join(lines)

(theme_dir / "colors.rasi").write_text(gen_rasi())
(theme_dir / "colors.css").write_text(gen_css())
(theme_dir / "colors.conf").write_text(gen_conf())

print(f"[LIEM]Successfully generated theme: {theme_dir}")

